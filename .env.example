# Copy to .env for local runs. Every value is also a GitHub Actions secret of the same
# name. The Databricks job itself needs none of these: a task running inside Databricks
# is already authenticated.

# --- Databricks (publish.py / dashboard.py read gold over the SQL warehouse) ---
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=themepark

# --- Supabase (serving store; PostgREST provides the REST API) ---
# The service-role key writes and must stay secret; the anon key is read-only.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
