# Copy to .env for local runs. Every value is also a GitHub Actions secret of the same
# name. Nothing here has a default in code -- a missing secret fails loudly at startup
# rather than silently falling back to something that half-works.

# --- Upstream Mapblazer Postgres (read-only; never written to) ---
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SSLMODE=require

# --- Databricks (lakehouse, MLflow tracking + registry, weekly job) ---
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=themepark

# --- Supabase (serving store; PostgREST provides the REST API) ---
# Service-role key writes and must stay secret. The anon key is read-only and is safe
# to publish -- it is in the README so the API is usable without asking for access.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# --- Pipeline tuning (all optional; defaults shown) ---
# HORIZON_DAYS=7
# GRID_MINUTES=30
# BACKTEST_DAYS=14
# MIN_IMPROVEMENT=0.02
# MAX_HIGH_WAIT_REGRESSION=0.05
# MIN_COVERAGE=0.95
