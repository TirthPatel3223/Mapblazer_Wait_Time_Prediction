[Unit]
Description=Run the theme park collector every 30 minutes
Documentation=https://github.com/TirthPatel3223/Mapblazer_Wait_Time_Prediction

[Timer]
OnBootSec=5min
OnUnitActiveSec=30min

# Spread the start within the window so the collector never lines up exactly with
# whatever else runs on this box on the hour and half-hour.
RandomizedDelaySec=120

# Catch up after a reboot or an outage rather than silently skipping the window.
Persistent=true

Unit=themepark-collect.service

[Install]
WantedBy=timers.target
